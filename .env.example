# Database & Cache
DATABASE_URL="postgresql://polaris_admin:polaris_secret_2026@localhost:5432/polaris_db"
REDIS_URL="redis://localhost:6379"
PII_ENCRYPTION_KEY="replace-with-at-least-32-random-bytes"
# Set true only during a controlled legacy CBC migration window, then remove/disable it.
PII_ALLOW_LEGACY_MASTER_KEY_DECRYPTION=false

# AI & Observability
OPENAI_API_KEY="sk-your-openai-api-key"
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_HOST="https://cloud.langfuse.com"

# Storage Cloudflare R2
R2_ACCOUNT_ID="your-cf-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="polaris-assets"
R2_PUBLIC_URL="https://assets.polaris.id"

# Storage Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
# Set after landing-page media has been uploaded to the CDN; leave empty for local public assets.
NEXT_PUBLIC_LANDING_MEDIA_BASE_URL=""

# Payment Gateway Midtrans
MIDTRANS_MERCHANT_ID="your-merchant-id"
MIDTRANS_SERVER_KEY="Mid-server-... or SB-Mid-server-..."
MIDTRANS_CLIENT_KEY="Mid-client-... or SB-Mid-client-..."
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="Mid-client-... or SB-Mid-client-..."
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false


# Domain & Production URLs
NEXT_PUBLIC_ROOT_DOMAIN="polarismedia.id"
NEXT_PUBLIC_API_URL="https://api.polarismedia.id/api/v1"
DASHBOARD_URL="https://app.polarismedia.id"

# Meta / Instagram Graph API OAuth
INSTAGRAM_APP_ID="your-meta-app-id"
INSTAGRAM_APP_SECRET="your-meta-app-secret"
INSTAGRAM_REDIRECT_URI="https://api.polarismedia.id/api/v1/social/instagram/callback"

