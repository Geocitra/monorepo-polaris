# =========================================================================
# STAGE 1: BASE ENVIRONMENT
# =========================================================================
FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.2.0 --activate
RUN apk add --no-cache libc6-compat

WORKDIR /app

# =========================================================================
# STAGE 2: DEPENDENCIES INSTALLER
# =========================================================================
FROM base AS dependencies
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/web-portal/package.json ./apps/web-portal/

RUN pnpm install --frozen-lockfile

# =========================================================================
# STAGE 3: BUILDER
# =========================================================================
FROM dependencies AS builder
ARG NEXT_PUBLIC_API_URL="https://api.polarismedia.id/api/v1"
ARG NEXT_PUBLIC_ROOT_DOMAIN="polarismedia.id"
ARG NEXT_PUBLIC_DASHBOARD_URL="https://app.polarismedia.id"
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_ROOT_DOMAIN=$NEXT_PUBLIC_ROOT_DOMAIN
ENV NEXT_PUBLIC_DASHBOARD_URL=$NEXT_PUBLIC_DASHBOARD_URL

COPY packages/shared-types/ ./packages/shared-types/
COPY apps/web-portal/ ./apps/web-portal/

ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @polaris/web-portal... build

# =========================================================================
# STAGE 4: PRODUCTION RUNNER
# =========================================================================
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME="0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder /app/apps/web-portal/public ./apps/web-portal/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web-portal/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web-portal/.next/static ./apps/web-portal/.next/static

USER nextjs
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 -O /dev/null http://127.0.0.1:3001 || exit 1

CMD ["node", "apps/web-portal/server.js"]
