{
  "name": "@polaris/worker-crawler",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/worker.js",
  "scripts": {
    "build": "tsup src/worker.ts --format cjs,esm --dts",
    "dev": "tsup src/worker.ts --format cjs,esm --dts --watch --onSuccess \"node dist/worker.js\"",
    "start": "node dist/worker.js",
    "check-types": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@polaris/ai-engine": "workspace:*",
    "@polaris/core-domain": "workspace:*",
    "@polaris/database": "workspace:*",
    "@polaris/payment": "workspace:*",
    "@polaris/shared-types": "workspace:*",
    "@polaris/storage": "workspace:*",
    "bullmq": "^5.41.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "ioredis": "^5.5.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
