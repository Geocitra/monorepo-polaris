# Database & Cache
DATABASE_URL="postgresql://polaris_admin:polaris_secret_2026@localhost:5432/polaris_db"
REDIS_URL="redis://localhost:6379"
PII_ENCRYPTION_KEY="replace-with-at-least-32-random-bytes"
# Set true only during a controlled legacy CBC migration window, then remove/disable it.
PII_ALLOW_LEGACY_MASTER_KEY_DECRYPTION=false

# AI & Observability
OPENAI_API_KEY="sk-your-openai-api-key"
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_HOST="https://cloud.langfuse.com"

# Storage Cloudflare R2
R2_ACCOUNT_ID="your-cf-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="polaris-assets"
R2_PUBLIC_URL="https://assets.polaris.id"

# Storage Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
# Set after landing-page media has been uploaded to the CDN; leave empty for local public assets.
NEXT_PUBLIC_LANDING_MEDIA_BASE_URL=""

# Payment Gateway Midtrans
MIDTRANS_MERCHANT_ID="your-merchant-id"
MIDTRANS_SERVER_KEY="Mid-server-... or SB-Mid-server-..."
MIDTRANS_CLIENT_KEY="Mid-client-... or SB-Mid-client-..."
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="Mid-client-... or SB-Mid-client-..."
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false


# Domain & Production URLs
NEXT_PUBLIC_ROOT_DOMAIN="polarismedia.id"
NEXT_PUBLIC_API_URL="https://api.polarismedia.id/api/v1"
DASHBOARD_URL="https://app.polarismedia.id"

# Meta / Instagram Graph API OAuth
INSTAGRAM_APP_ID="your-meta-app-id"
INSTAGRAM_APP_SECRET="your-meta-app-secret"
INSTAGRAM_REDIRECT_URI="https://api.polarismedia.id/api/v1/social/instagram/callback"


# Meta / Threads API OAuth
THREADS_APP_ID="your-threads-app-id"
THREADS_APP_SECRET="your-threads-app-secret"
THREADS_REDIRECT_URI="https://api.polarismedia.id/api/v1/social/threads/callback"

# X (Twitter) Developer API (OAuth 1.0a & OAuth 2.0 PKCE)
X_CONSUMER_KEY="your-x-consumer-key"
X_CONSUMER_SECRET="your-x-consumer-secret"
X_BEARER_TOKEN="your-x-bearer-token"
X_CLIENT_ID="your-x-oauth2-client-id"
X_CLIENT_SECRET="your-x-oauth2-client-secret"
X_REDIRECT_URI="https://api.polarismedia.id/api/v1/social/x/callback"

# TikTok Developer API
TIKTOK_CLIENT_KEY="your-tiktok-client-key"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"
TIKTOK_REDIRECT_URI="https://api.polarismedia.id/api/v1/social/tiktok/callback"