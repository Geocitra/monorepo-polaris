# =========================================================================
# STAGE 1: BASE ENVIRONMENT & PNPM SETUP
# =========================================================================
FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.2.0 --activate
RUN apk add --no-cache libc6-compat python3 make g++

WORKDIR /app

# =========================================================================
# STAGE 2: DEPENDENCIES INSTALLER
# =========================================================================
FROM base AS dependencies
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages/core-domain/package.json ./packages/core-domain/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/database/package.json ./packages/database/
COPY packages/payment/package.json ./packages/payment/
COPY packages/storage/package.json ./packages/storage/
COPY packages/ai-engine/package.json ./packages/ai-engine/
COPY apps/api-core/package.json ./apps/api-core/

RUN pnpm install --frozen-lockfile

# =========================================================================
# STAGE 3: BUILDER
# =========================================================================
FROM dependencies AS builder
COPY packages/ ./packages/
COPY apps/api-core/ ./apps/api-core/

RUN pnpm --filter @polaris/api-core... build

# =========================================================================
# STAGE 4: PRODUCTION RUNNER (NON-ROOT USER)
# =========================================================================
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

# Keamanan: Buat user non-root khusus nodejs
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nodejs

COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/api-core/package.json ./apps/api-core/package.json
COPY --from=builder /app/apps/api-core/dist ./apps/api-core/dist

USER nodejs
EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:4000/api/v1/commissions || exit 1

CMD ["node", "apps/api-core/dist/main.js"]
