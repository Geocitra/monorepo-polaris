# =========================================================================
# STAGE 1: BASE ENVIRONMENT
# =========================================================================
FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.2.0 --activate
RUN apk add --no-cache libc6-compat

WORKDIR /app

# =========================================================================
# STAGE 2: DEPENDENCIES INSTALLER
# =========================================================================
FROM base AS dependencies
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/web-dashboard/package.json ./apps/web-dashboard/

RUN pnpm install --frozen-lockfile

# =========================================================================
# STAGE 3: BUILDER
# =========================================================================
FROM dependencies AS builder
ARG NEXT_PUBLIC_API_URL="https://api.polarismedia.id/api/v1"
ARG NEXT_PUBLIC_ROOT_DOMAIN="polarismedia.id"
ARG NEXT_PUBLIC_PORTAL_URL="https://polarismedia.id"
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_ROOT_DOMAIN=$NEXT_PUBLIC_ROOT_DOMAIN
ENV NEXT_PUBLIC_PORTAL_URL=$NEXT_PUBLIC_PORTAL_URL

COPY packages/shared-types/ ./packages/shared-types/
COPY apps/web-dashboard/ ./apps/web-dashboard/

ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @polaris/web-dashboard... build

# =========================================================================
# STAGE 4: PRODUCTION RUNNER (STANDALONE ISOLATION < 180 MB)
# =========================================================================
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Salin output standalone minimal Next.js
COPY --from=builder /app/apps/web-dashboard/public ./apps/web-dashboard/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web-dashboard/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web-dashboard/.next/static ./apps/web-dashboard/.next/static

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 -O /dev/null http://127.0.0.1:3000/login || exit 1

CMD ["node", "apps/web-dashboard/server.js"]
